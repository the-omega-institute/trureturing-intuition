{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-edit-graph-patch-receipt.v1",
  "title": "Immutable receipt for one explicit structure graph patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "patch_ref",
    "patch_id",
    "candidate_ref",
    "candidate_id",
    "truth_release_digest",
    "topology_atlas_digest",
    "topology_atlas_evidence_digest",
    "operation_count",
    "authority"
  ],
  "properties": {
    "schema": { "const": "structure-edit-graph-patch-receipt.v1" },
    "patch_ref": { "$ref": "#/$defs/digest" },
    "patch_id": { "$ref": "#/$defs/digest" },
    "candidate_ref": { "$ref": "#/$defs/digest" },
    "candidate_id": { "$ref": "#/$defs/digest" },
    "truth_release_digest": { "$ref": "#/$defs/digest" },
    "topology_atlas_digest": { "$ref": "#/$defs/digest" },
    "topology_atlas_evidence_digest": { "$ref": "#/$defs/digest" },
    "operation_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "authority": { "const": "advisory" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
